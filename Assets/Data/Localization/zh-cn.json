  "turret_frost_turret_desc": "发射冰冷射击来减速敌人。强力控制炮塔，让输出炮塔有更多攻击时间。",
  "turret_frost_turret_unlock": "到达第10波",
  "turret_frost_turret_path_a_name": "冷冻锁定炮塔",
  "turret_frost_turret_path_a_desc": "攻击附带短暂冻结爆发。适合打断危险敌人并创造爆发窗口。",
  "turret_frost_turret_path_b_name": "冰川领域炮塔",
  "turret_frost_turret_path_b_desc": "在目标周围扩散减速，控制群体而非单个敌人。对密集波次极强。",
  "turret_inferno_turret_name": "炼狱炮塔",
  "turret_inferno_turret_desc": "持续造成燃烧伤害。燃烧会随每次命中叠加，攻击速度和燃烧加成会成倍提高总燃烧伤害。",
  "turret_inferno_turret_unlock": "累计减速敌人50秒",
  "turret_inferno_turret_path_a_name": "爆炎炮塔",
  "turret_inferno_turret_path_a_desc": "发射燃烧投射物，命中时爆炸并伤害目标周围敌人。",
  "turret_inferno_turret_path_b_name": "余烬叠加器",
  "turret_inferno_turret_path_b_desc": "重复命中同一敌人会叠加额外燃烧伤害。适合长战斗和无尽成长。",
  "turret_laser_turret_name": "激光炮塔",
  "turret_laser_turret_desc": "用持续光束锁定一名敌人。光束停留在同一目标上越久，伤害越高，非常克制留在射程内的坦克。",
  "turret_laser_turret_unlock": "用连锁闪电命中200名敌人",
  "turret_laser_turret_path_a_name": "多重激光",
  "turret_laser_turret_path_a_desc": "将光束分散到多个敌人。牺牲单体威力换取稳定群体压制。",
  "turret_laser_turret_path_b_name": "叠加激光",
  "turret_laser_turret_path_b_desc": "专注单一目标，保持接触时间越长，光束伤害越高。蓄满时还会每秒处决目标一部分已损失生命值。名副其实的Boss与坦克杀手。",
  "turret_lightning_turret_name": "闪电炮塔",
  "turret_lightning_turret_desc": "发射带电射击，在附近敌人间连锁。灵活的反群炮塔，清波潜力强。",
  "turret_lightning_turret_unlock": "造成总计5000点燃烧伤害",
  "turret_lightning_turret_path_a_name": "风暴连锁炮塔",
  "turret_lightning_turret_path_a_desc": "将闪电连锁扩展到更多敌人，在大群中扩散伤害。最适合密集波次。",
  "turret_lightning_turret_path_b_name": "伏特收割者",
  "turret_lightning_turret_path_b_desc": "对连锁敌人增加百分比伤害，使其对坦克和高生命目标仍然有效。",
  "turret_radar_turret_name": "扫描炮塔",
  "turret_radar_turret_desc": "揭示大范围内的隐身敌人。升级可扩大侦测范围。对付隐藏威胁必不可少，但没有直接伤害",
  "turret_radar_turret_unlock": "达到第15波",
  "turret_radar_turret_path_a_name": "",
  "turret_radar_turret_path_a_desc": "",
  "turret_radar_turret_path_b_name": "",
  "turret_radar_turret_path_b_desc": "",
  "turret_support_turret_name": "增幅炮塔",
  "turret_support_turret_desc": "不攻击。提升附近炮塔伤害，让集群防御更强。",
  "turret_support_turret_unlock": "到达第25波",
  "turret_support_turret_path_a_name": "超频增幅器",
  "turret_support_turret_path_a_desc": "提升附近炮塔的伤害和攻速。适合进攻构筑的强力成长支援。",
  "turret_support_turret_path_b_name": "压制场",
  "turret_support_turret_path_b_desc": "强化附近炮塔并减速光环内敌人。防御型支援，让整体防线获得更多时间。",
